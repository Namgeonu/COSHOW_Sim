<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aideck_aruco_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 node that receives AI-Deck UDP video streams, detects ArUco markers and publishes images plus detections.</description>
  <maintainer email="imdaniel01@naver.com">jaewoo</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>coshow_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- OpenCV with cv2.aruco. This machine uses the pip wheel in
       ~/.local (opencv 5.0.0); rosdep's python3-opencv also works. -->
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
