<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- Phase 1: limo_a → 관측점 P0, 드론 A 이륙 → P0 상공 → 마커 검출 대기 -->
  <BehaviorTree ID="phase1_observe">
    <ReactiveSequence>
      <ReactiveFallback>
        <IsLimoAt robot="limo_a" x="0.0" y="0.0"/>
        <LimoNavigateTo robot="limo_a" x="0.0" y="0.0" yaw="1.57"/>
      </ReactiveFallback>
      <ReactiveFallback>
        <IsDroneAirborne robot="cf230"/>
        <DroneTakeoff robot="cf230"/>
      </ReactiveFallback>
      <ReactiveFallback>
        <IsDroneAt robot="cf230" x="0.0" y="0.0" alt="observe"/>
        <DroneGoTo robot="cf230" x="0.0" y="0.0" alt="observe"/>
      </ReactiveFallback>
      <Idle/>
    </ReactiveSequence>
  </BehaviorTree>
</root>
